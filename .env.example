# Boş bırakılırsa yerel SQLite kullanılır
DATABASE_URL=

# Yazma uç noktalarını (tarif, malzeme, buzdolabı) koruyan anahtar.
# Yerelde boşsa korumasız; Vercel'de boşsa yazma istekleri 503 verir.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=

# "Bugün"ün hesaplandığı saat dilimi (son kullanma tarihleri için). Boşsa Europe/Istanbul.
# TIMEZONE=Europe/Istanbul

# Yayın (Vercel) için Supabase transaction pooler, port 6543:
# DATABASE_URL=postgresql://postgres.<proje-ref>:<şifre>@aws-0-<bölge>.pooler.supabase.com:6543/postgres
